DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
DATA_DIR=./data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clientpulse
STORAGE_PROVIDER=supabase
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth Client ID and Secret go in Supabase Dashboard > Google provider.
# No Google client secret belongs in NEXT_PUBLIC_* variables. See docs/GOOGLE_SIGN_IN.md.
MAX_FILE_MB=25
VIDEO_MAX_SECONDS=120
# Select sarvam or deepgram for uploaded call transcription.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_LANGUAGE=unknown
DEEPGRAM_API_KEY=
REDACT_SENSITIVE=true
WEB_ORIGINS=https://your-frontend-domain.example

# Customer email sending: backend-only credentials for the Resend integration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
