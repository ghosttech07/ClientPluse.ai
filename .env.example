DATABASE_URL=sqlite:///./data/evidence.db
DATA_DIR=./data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence
STORAGE_PROVIDER=local
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth Client ID and Secret go in Supabase Dashboard > Google provider.
# No Google client secret belongs in NEXT_PUBLIC_* variables. See docs/GOOGLE_SIGN_IN.md.
MAX_FILE_MB=25
VIDEO_MAX_SECONDS=120
HF_TOKEN=
# Enable only after tests/check_huggingface.py succeeds with deployed credentials.
HF_ENABLED=false
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_ASR_MODEL=openai/whisper-large-v3-turbo
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
HF_VISION_PROVIDER=featherless-ai
# Optional dedicated BGE reranker endpoint (base URL, without /rerank).
HF_RERANK_URL=
